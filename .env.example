# =============================================================================
# Produtiva Gestão — variáveis de ambiente (API, worker e robôs)
# Copie para .env (produção/docker) ou apps/api/.env.local (desenvolvimento).
# =============================================================================

# ---------- Modo ----------
# sandbox = integrações simuladas (SERPRO, SEFAZ, NFS-e, WhatsApp, e-mail, push, CNPJ). live = reais.
INTEGRATIONS_MODE=sandbox
NODE_ENV=development
PORT=3333
PUBLIC_API_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
OFFICE_CNPJ=                       # CNPJ do escritório (usado no build do app do cliente)

# ---------- Banco (3 papéis — ver packages/db/prisma/roles.sql) ----------
MIGRATION_DATABASE_URL=postgresql://produtiva:produtiva@localhost:5432/produtiva          # dono das tabelas: só migração
DATABASE_URL=postgresql://produtiva_app:produtiva_app@localhost:5432/produtiva            # API HTTP (RLS sempre ativo)
SYSTEM_DATABASE_URL=postgresql://produtiva_system:produtiva_system@localhost:5432/produtiva # workers/login/webhooks (BYPASSRLS)
DB_POOL_MAX=10
POSTGRES_PASSWORD=produtiva
APP_DB_PASSWORD=produtiva_app
SYSTEM_DB_PASSWORD=produtiva_system

# ---------- Filas ----------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=produtiva
SCHEDULER=off                      # "on" em UMA réplica do worker (agenda Monitor, recorrências, exportações)
RPA_CONCURRENCY=2
BROADCAST_DELAY_MS=4000            # intervalo entre mensagens das listas de transmissão

# ---------- Segurança ----------
JWT_SECRET=troque-por-um-segredo-longo-de-verdade
# 32 bytes em hex (openssl rand -hex 32). Em produção, use KMS.
VAULT_MASTER_KEY=

# ---------- Arquivos ----------
STORAGE_DRIVER=s3                  # s3 | local
STORAGE_DIR=./storage              # quando local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=produtiva
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=produtiva
AWS_SECRET_ACCESS_KEY=produtiva123

# ---------- SERPRO Integra Contador (Loja Serpro) ----------
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# SERPRO_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
# SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1

# ---------- NFS-e Padrão Nacional ----------
NFSE_TPAMB=2                       # 1 produção, 2 homologação
# NFSE_SEFIN_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# NFSE_ADN_URL=https://adn.producaorestrita.nfse.gov.br

# ---------- XML ----------
XML_EXPORT_TARGET=ZIP              # ZIP | DOMINIO | ALTERDATA (exportação diária às 11h)

# ---------- WhatsApp ----------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Alternativa não oficial (QR Code): Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---------- Chamadas do chat interno (LiveKit) ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------- Robôs ----------
FGTS_DIGITAL_URL=https://fgtsdigital.sistema.gov.br

# ---------- Observabilidade ----------
SENTRY_DSN=                        # opcional: erros da API e dos workers no Sentry
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
APP_VERSION=

# ---------- IA (Claude) ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---------- Seed (primeira carga) ----------
SEED_TENANT_CNPJ=
SEED_ADMIN_EMAIL=admin@produtiva.local
SEED_ADMIN_PASSWORD=
